<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="using:MacroPad.Controls.Settings"
			 xmlns:icons="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="512" d:DesignHeight="112"
             x:Class="MacroPad.Controls.Settings.PluginRow"
			 x:DataType="local:PluginRowViewModel">

	<Design.DataContext>
		<local:PluginRowViewModel/>
	</Design.DataContext>
	
	<Border Classes="card" Padding="8">
		<Grid ColumnDefinitions="96,*">
			<icons:SymbolIcon Symbol="" FontSize="96" VerticalAlignment="Top"/>
			<StackPanel Grid.Column="1">
				<TextBlock Classes="h4" Text="{CompiledBinding Plugin.Name}"/>
				<TextBlock Text="{CompiledBinding Plugin.Description}"/>
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Height="36" VerticalAlignment="Bottom" Spacing="4">
				<Button Width="36" Padding="0">
					<icons:SymbolIcon Symbol="ArrowClockwise"/>
				</Button>
				<Button Width="36" Padding="0">
					<icons:SymbolIcon Symbol="Settings"/>
				</Button>
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Height="36" VerticalAlignment="Top" Spacing="4">
				<TextBlock Text="Enable"/>
				<ToggleSwitch Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" OffContent="" OnContent="" Padding="0" Margin="4 -14 -8 0"/>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
